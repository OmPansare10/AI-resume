# Cloud LLM Configuration (Free at https://console.groq.com/keys - zero local storage required!)
# When GROQ_API_KEY is set, the system automatically uses Cloud Llama 3.3 70B instead of local storage.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Configuration (Fallback if GROQ_API_KEY is not set)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional OpenAI fallback
# OPENAI_API_KEY=
